<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <ImageView
        android:id="@+id/detailCover"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:contentDescription="@string/cover_description"
        android:src="@drawable/cover_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detailCover"
        app:layout_constraintTop_toTopOf="@id/detailCover"
        tools:text="The Pragmatic Programmer" />

    <TextView
        android:id="@+id/detailAuthor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/detailTitle"
        app:layout_constraintStart_toStartOf="@id/detailTitle"
        app:layout_constraintTop_toBottomOf="@id/detailTitle"
        tools:text="David Thomas, Andrew Hunt" />

    <TextView
        android:id="@+id/detailStatus"
        style="@style/Widget.Sample.Badge"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_available"
        android:text="@string/status_available"
        android:textColor="@color/on_badge_available"
        app:layout_constraintStart_toStartOf="@id/detailTitle"
        app:layout_constraintTop_toBottomOf="@id/detailAuthor" />

    <TextView
        android:id="@+id/detailDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailCover"
        tools:text="A practical guide to software craftsmanship." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/borrowButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/action_borrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailDescription" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reserveButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/action_reserve"
        app:layout_constraintBaseline_toBaselineOf="@id/borrowButton"
        app:layout_constraintStart_toEndOf="@id/borrowButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
